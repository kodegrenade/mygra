#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * Mygra CLI - Universal Database Migration Tool
 *
 * Usage:
 *   php mygra migrate --config=config/mygra.yaml --schema=users
 *   php mygra inspect --connection=source users
 *   php mygra suggest source_table target_table
 */

// Composer 2.2+ tells installed binaries where the project's autoloader is. Otherwise: a clone of
// this repository, or an older Composer running vendor/kodegrenade/mygra/mygra from vendor/bin.
$autoloaderPaths = [
  $GLOBALS['_composer_autoload_path'] ?? null,
  __DIR__ . '/vendor/autoload.php',
  __DIR__ . '/../../autoload.php',
];

$autoloaderFound = false;
foreach (array_filter($autoloaderPaths) as $path) {
  if (file_exists($path)) {
    require_once $path;
    $autoloaderFound = true;
    break;
  }
}

if (!$autoloaderFound) {
  fwrite(STDERR, "Error: Could not find Composer autoloader.\n");
  fwrite(STDERR, "Please run 'composer install' first.\n");
  exit(1);
}

use Mygra\CLI\Application;

// Run the application
$app = new Application();
$exitCode = $app->run();

exit($exitCode);
