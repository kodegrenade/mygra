{
  "name": "grenade/mygra",
  "description": "Universal Database Schema Migration Tool",
  "type": "library",
  "license": "MIT",
  "keywords": [
    "database",
    "migration",
    "schema",
    "mysql",
    "postgresql",
    "sqlite",
    "sqlserver"
  ],
  "authors": [
    {
      "name": "Grenade Team"
    }
  ],
  "autoload": {
    "psr-4": {
      "Mygra\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Mygra\\Tests\\": "tests/"
    }
  },
  "require": {
    "php": ">=8.1",
    "ext-pdo": "*",
    "symfony/console": "^6.0|^7.0",
    "symfony/yaml": "^6.0|^7.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.0"
  },
  "bin": [
    "mygra"
  ],
  "scripts": {
    "test": "./vendor/bin/phpunit tests/Unit",
    "test:integration": "./vendor/bin/phpunit tests/Integration",
    "migrate": "php mygra migrate"
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true
  }
}
