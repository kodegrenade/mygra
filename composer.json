{
  "name": "kodegrenade/mygra",
  "description": "Config-driven data migration between MySQL, PostgreSQL, SQLite and SQL Server: transforms, validation, ID mapping, resume and verify",
  "type": "library",
  "license": "MIT",
  "keywords": [
    "database",
    "migration",
    "data-migration",
    "etl",
    "mysql",
    "postgresql",
    "sqlite",
    "sqlserver",
    "cli"
  ],
  "homepage": "https://github.com/kodegrenade/mygra",
  "support": {
    "issues": "https://github.com/kodegrenade/mygra/issues",
    "source": "https://github.com/kodegrenade/mygra"
  },
  "authors": [
    {
      "name": "Temitope Ayotunde",
      "role": "Maintainer"
    }
  ],
  "require": {
    "php": "^8.1",
    "ext-pdo": "*",
    "psr/log": "^2.0|^3.0",
    "symfony/console": "^6.4|^7.0|^8.0",
    "symfony/yaml": "^6.4|^7.0|^8.0"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.64",
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^10.0"
  },
  "autoload": {
    "psr-4": {
      "Mygra\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Mygra\\Tests\\": "tests/"
    }
  },
  "bin": [
    "mygra"
  ],
  "scripts": {
    "test": "phpunit --testsuite unit",
    "test:integration": "phpunit --testsuite integration",
    "analyse": "phpstan analyse --memory-limit=1G",
    "cs": "php-cs-fixer fix --dry-run --diff",
    "cs:fix": "php-cs-fixer fix"
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true,
    "platform": {
      "php": "8.1.0"
    }
  }
}
